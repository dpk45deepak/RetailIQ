# Copy to .env and adjust. All values are optional.
RETAILIQ_ROOT=.
# If set, the API requires this value in the X-API-Key header.
RETAILIQ_API_KEY=
# Streamlit/API log level
RETAILIQ_LOG_LEVEL=INFO
# Dashboard: set to the deployed API URL if you want pages to call it (optional).
RETAILIQ_API_URL=http://localhost:8000
